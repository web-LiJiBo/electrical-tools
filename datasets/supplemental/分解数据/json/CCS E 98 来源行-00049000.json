  "rules": [
    {
      "content": "      1   实际管道上的交流腐蚀坑一般为圆形，若采用过于细长\n的交流腐蚀试片来评价交流腐蚀风险时，其接地电阻倾向于小\n于同等面积的圆形试片，导致测量的交直流密度偏大。",
      "type": "语义分解",
