  "rules": [
    {
      "content": "6.12.6 滩海陆岸石油设施应至少配备以下救生设备: 4个救生圈(带30 m 救生浮索) ,其中2个带自亮浮灯; 按定员100%配备工作救生衣; 冬季作业按定员100%配备保温救生服; 可供工作人员5 d食用的救生口粮 ,饮用水; 配备急救箱。急救箱内至少装有2套工作救生衣,防水手电及配套电池 ,简单的医疗包扎用品和日常常用药品。",
      "type": "语义分解",
