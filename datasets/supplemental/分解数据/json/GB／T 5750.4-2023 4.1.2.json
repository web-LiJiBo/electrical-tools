  "rules": [
    {
      "content": "4.1.2 原理 用氯铂酸钾和氯化钴配制成与天然水黄色色调相似的标准色列，用于水样目视比色测定。规定1 mg/L铂[以(PtCl6)形式存在]所具有的颜色作为1个色度单位，称为1度。即使轻微的浑浊度也干扰测定，浑浊水样测定时需先离心，使之清澈。",
      "type": "语义分解",
      "subject": "水样色度测定",
      "action": "",
      "operation": "以铂钴色列目视比色浑浊水样先离心至清澈",
      "condition": "",
