  ],
  "rules": [
    {
      "content": "5.2.5.1.4 钻具内防喷工具应符合下列要求: 钻具内防喷工具的额定工作压力应不小于井口防喷器额定工作压力; 应使用方钻杆旋塞 ,并定期活动;钻台上配备与钻具尺寸相符的钻具止回阀或旋塞阀; 钻台上准备一根防喷钻杆单根(带与钻铤连接螺纹相符合的配合接头和钻具止回阀) ; 应配备钻井液循环池液面监测与报警装置; 按设计要求配齐钻井液净化装置 ,探井 气井及气比油高的油井还应配备钻井液气体分离器和除气器 ,并将液气分离器排气管线(按设计通径)接出井口50 m 以上。",
      "type": "语义分解",
      "subject": "钻具内防喷工具",
      "action": "",
      "operation": "额定压力不低于防喷器配匹配旋塞止回阀防喷单根液位报警净化及适用井分离除气",
      "condition": "",
