  "chapter_path": "5.3.4",
  "entities": [
    {
      "name": "多产品循环流分配",
      "type": "条款对象"
    }
  ],
  "rules": [
    {
      "content": "5.3.4 物质流，能量流和排放物的分配 只产出单一产品，或者其原材料输入和输出仅体现为一种线性关系的工业过程极为少见。事实上，大部分工业过程都是产出多种产品，并将中间产品和弃置的产品通过再生利用当作原材料。因此，在对包含有多个产品或循环体系的系统时，宜考虑分配程序的需要。",
      "type": "语义分解",
      "subject": "多产品循环流分配",
      "action": "",
      "operation": "多产品循环系统考虑分配程序",
      "condition": "",
