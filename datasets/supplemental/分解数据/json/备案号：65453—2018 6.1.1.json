  "entities": [
    {
      "name": "有外防腐层的管道间接检测内容应包括阴极保护有效性 评价、防腐层完整性评价",
      "type": "条款对象"
    }
  ],
  "rules": [
    {
      "content": "6.1.1   有外防腐层的管道间接检测内容应包括阴极保护有效性\n评价、防腐层完整性评价、土壤腐蚀性等内容。开展管道阴极\n保护有效性评价时，应对管道存在的交直流干扰情况和程度进\n行评估；对无外防腐层的管道或防腐层质量较差的管道，宜以\n确定腐蚀活性为主。",
      "type": "语义分解",
