  "rules": [
    {
      "content": "6.3 全员参与 企业应畅通从业人员参与安全生产的渠道，鼓励从业人员参与安全生产管理。企业应及时收集、答复、落实从业人员提出的安全生产建议和内部隐患报告，并公开进行相应奖励。工会应对安全生产工作进行监督，组织从业人员参加安全生产民主管理和民主监督，维护其安全生产合法权益。",
      "type": "语义分解",
      "subject": "全员参与",
      "action": "",
