  "rules": [
    {
      "content": "5.5 科技保障 企业应根据自身实际情况，开展安全生产科学技术研究，推广应用先进技术装备，推进危险岗位无人值守或机器人作业，提高企业本质安全水平。企业应利用数字化、信息化、智能化等手段，提高安全生产台账管理、安全风险分级管控、事故隐患排查治理、应急管理等效能。企业应推广应用安全风险监测预警系统，具备安全风险隐患的智能识别、快速感知、实时监测、超前预警等功能。",
      "type": "语义分解",
