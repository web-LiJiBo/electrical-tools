    {
      "device_id": "SIM-IEC-VALVE-01",
      "device_type": "pole_controller",
      "scenario": "power_grid_operation",
      "protocol": "IEC61850",
      "initial_state": {
        "active_power_mw": 100,
        "dc_blocked": false
      },
      "runtime_facts": {
        "outlet_temperature_protection_operated": 1,
        "runback_permission": 1,
        "runback_applied": 0,
        "runback_target_configured": 1,
        "runback_target_mw": 80,
        "dc_blocked": 0
      },
      "configuration_scope": "仅作软件测试，80 MW是测试预设，不是标准定值；无真实通信客户端",
      "mapping": {
        "object_reference": "SIM_POLE/CTRL/GGIO1.AnOut1",
        "control_model": "direct-with-normal-security",
        "service": "Operate"
      },
      "actions": {
        "runback_power": {
          "function": "converter_valve_runback",
          "condition": "outlet_temperature_protection_operated == 1",
          "constraints": [
            {
              "parameter": "runback_permission",
              "operator": ">=",
              "value": 1,
              "role": "precondition"
            },
            {
              "parameter": "runback_target_configured",
              "operator": "==",
              "value": 1,
              "role": "precondition"
            },
            {
              "parameter": "runback_applied",
              "operator": "==",
              "value": 0,
              "role": "precondition"
            },
            {
              "parameter": "dc_blocked",
              "operator": "==",
              "value": 0,
              "role": "precondition"
            }
          ],
          "parameter": "target_power_mw",
          "unit": "MW",
          "minimum": 0,
          "maximum": 100,
          "configured_parameter_fact": "runback_target_mw",
          "decrease_only": true,
          "state_key": "active_power_mw",
          "source_rule_ids": [
            "1626_clause2:rule:1"
          ],
          "source_bindings": {
            "1626_clause2:rule:1": {
              "source_action": "向极控系统发功率回降命令",
              "source_condition": "阀出水温度异常",
              "source_quote": "阀出水温度保护动作后应向极控系统发功率回降命令，不宜发直流闭锁命令。",
              "verified_condition": "outlet_temperature_protection_operated == 1",
              "constraint_bindings": {
                "不宜发直流闭锁命令": {
                  "parameter": "dc_blocked",
                  "operator": "==",
                  "value": 0,
                  "role": "precondition"
                }
              },
              "scope": "仅此来源条款的模拟信号映射，不推导温度阈值，不认定现场标准适用性"
            }
          },
          "source_scope": "synthetic_test_fixture_pending_source_binding",
          "expected_feedback": {
            "state_key": "active_power_mw",
            "parameter": "target_power_mw",
            "value": null
          }
        }
      }
    },
